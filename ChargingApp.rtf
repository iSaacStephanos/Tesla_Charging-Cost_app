<script>\
  const CAPACITY = 79.0;\
  const SC_RATE = 50.0;\
  let logs = JSON.parse(localStorage.getItem('tesla_logs')) || [];\
\
  function calculate() \{\
    const current = parseFloat(document.getElementById('currentSoc').value) || 0;\
    const target = parseFloat(document.getElementById('targetSoc').value) || 0;\
    const fee = parseFloat(document.getElementById('cost').value) || 0;\
\
    const diffSoc = Math.max(0, target - current);\
    const kwh = CAPACITY * (diffSoc / 100);\
    const unitPrice = kwh > 0 ? (fee / kwh) : 0;\
    const saving = (kwh * SC_RATE) - fee;\
\
    document.getElementById('unitPrice').innerText = `$\{unitPrice.toFixed(1)\} \uc0\u20870 /kWh`;\
    const scCompEl = document.getElementById('scComparison');\
    \
    if (kwh === 0) \{\
      scCompEl.innerText = '0 \uc0\u20870 ';\
      scCompEl.className = '';\
    \} else if (saving >= 0) \{\
      scCompEl.innerText = `SC\uc0\u12424 \u12426  $\{Math.round(saving).toLocaleString()\}\u20870  \u12362 \u24471 `;\
      scCompEl.className = ''; scCompEl.style.color = '#4ade80';\
    \} else \{\
      scCompEl.innerText = `SC\uc0\u12424 \u12426  $\{Math.round(Math.abs(saving)).toLocaleString()\}\u20870  \u21106 \u39640 `;\
      scCompEl.className = 'warning';\
    \}\
  \}\
\
  function saveLog(status, typeClass) \{\
    const now = new Date();\
    const timeStr = `$\{now.getMonth()+1\}/$\{now.getDate()\} $\{now.getHours().toString().padStart(2,'0')\}:$\{now.getMinutes().toString().padStart(2,'0')\}`;\
    logs.unshift(\{ time: timeStr, status: status, type: typeClass \});\
    if(logs.length > 30) logs.pop(); // \uc0\u26368 \u26032 30\u20214 \u12434 \u20445 \u25345 \
    localStorage.setItem('tesla_logs', JSON.stringify(logs));\
    renderLogs();\
  \}\
\
  function renderLogs() \{\
    const list = document.getElementById('logList');\
    list.innerHTML = '';\
    logs.forEach(log => \{\
      list.innerHTML += `<li class="log-item $\{log.type\}">\
        <span>$\{log.status\}</span>\
        <span class="log-time">$\{log.time\}</span>\
      </li>`;\
    \});\
  \}\
\
  document.querySelectorAll('input').forEach(el => el.addEventListener('input', calculate));\
  calculate();\
  renderLogs();\
</script>\
